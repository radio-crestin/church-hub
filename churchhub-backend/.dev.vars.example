# Copy this file to .dev.vars and fill in your values
# DO NOT commit .dev.vars to version control

YOUTUBE_CLIENT_ID=your-client-id
YOUTUBE_CLIENT_SECRET=your-client-secret
COOKIE_ENCRYPTION_KEY=your-32-byte-hex-key
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8086

# Development
YOUTUBE_REDIRECT_URI=http://localhost:8787/auth/youtube/callback

# Production (set via wrangler secret)
# YOUTUBE_REDIRECT_URI=https://churchub-backend.radiocrestin.ro/auth/youtube/callback

# GitHub API Token for creating issues from user feedback
# How to create:
# 1. Go to https://github.com/settings/tokens?type=beta (Fine-grained tokens)
# 2. Click "Generate new token"
# 3. Name: "ChurchHub Feedback Bot" (or similar)
# 4. Expiration: Choose as needed (recommend 1 year or no expiration)
# 5. Repository access: Select "Only select repositories" -> radio-crestin/church-hub
# 6. Permissions -> Repository permissions -> Issues: Read and Write (only;
#    feature-request screenshots live in R2, not in the repo)
# 7. Click "Generate token" and copy the value
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# WhatsApp notice for each "Request a feature" submission, sent through WAHA
# (WhatsApp HTTP API). Optional: when WAHA_URL/WAHA_API_KEY/WAHA_CHAT_ID are
# unset, the GitHub issue is still created and WhatsApp is skipped.
# WAHA_URL=https://waha.example.com
# WAHA_API_KEY=your-waha-api-key
# WAHA_SESSION=default
# WAHA_CHAT_ID=40700000000@c.us
# Only when WAHA is behind Cloudflare Access (service token):
# WAHA_ACCESS_CLIENT_ID=your-access-client-id.access
# WAHA_ACCESS_CLIENT_SECRET=your-access-client-secret
