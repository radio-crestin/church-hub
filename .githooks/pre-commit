#!/bin/sh
# pre-commit hook — refuses a commit that adds a secret: gitleaks over the
# staged changes (.gitleaks.toml), then key shapes gitleaks can miss.
#
# Set up by `bun install` (app/scripts/install-git-hooks.js sets
# core.hooksPath=.githooks). A false positive: add an [[allowlists]] entry
# in .gitleaks.toml.

set -eu

root="$(git rev-parse --show-toplevel)"
. "$root/.githooks/require-gitleaks.sh"

gitleaks git --staged --redact --no-banner --config "$root/.gitleaks.toml" "$root"
sh "$root/scripts/check-key-shapes.sh" --staged
