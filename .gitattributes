# Cross-platform line endings.
#
# On Windows, core.autocrlf=true checks text files out with CRLF. For the DB
# migration sources and the file generated from them, that CRLF leaks into the
# generated `embedded.ts` (every \n becomes \r\n) the next time the sidecar is
# compiled, producing a spurious cross-platform diff. Force LF for these so the
# generated output is byte-identical on macOS, Windows and Linux.
app/apps/server/drizzle/migrations/*.sql text eol=lf
app/apps/server/src/db/migrations/embedded.ts text eol=lf

# Shell scripts must be LF everywhere. With core.autocrlf=true — which a
# contributor may well have set globally, and which is the default on a Windows
# checkout — a script comes back with CRLF and its shebang becomes
# `#!/usr/bin/env bash\r`, so running it fails with
# `env: bash\r: No such file or directory`. That made scripts/release.sh
# unrunnable on macOS.
*.sh text eol=lf

# Native modules are binary — never apply text/EOL conversion to them.
*.node binary
