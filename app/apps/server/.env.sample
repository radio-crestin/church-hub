# WARNING: Although this is a server .env, keep in mind that the server will be used as a client on desktop environment. Make sure to not include any sensitive credentials here. Treat this as a browser .env as well.

# This port is only used in local development. In prod, Tauri manages the port automatically
PORT=3000

# Database path for SQLite storage (configs, settings, cache)
# Default: ./data/app.db
DATABASE_PATH=./data/app.db

# Enable debug logging (optional)
# DEBUG=true

# --- Google OAuth (YouTube livestream + Google Drive backup) ---
# Both flows go through the ChurchHub OAuth worker (Cloudflare), which holds the
# Google client credentials server-side — the app ships with NO embedded Google
# credentials. Override only to point at a different worker deployment.
# YOUTUBE_OAUTH_SERVER=https://churchub-backend.radiocrestin.ro
