# WARNING: Although this is a server .env, keep in mind that the server will be used as a client on desktop environment. Make sure to not include any sensitive credentials here. Treat this as a browser .env as well.

# This port is only used in local development. In prod, Tauri manages the port automatically
PORT=3000

# Database path for SQLite storage (configs, settings, cache)
# Default: ./data/app.db
DATABASE_PATH=./data/app.db

# Enable debug logging (optional)
# DEBUG=true

# --- Google Drive backup ---
# Independent OAuth "Desktop app" client from the ChurchHub Google Cloud project
# (separate from the livestream YouTube client). Enables backing up the database
# to the user's private Google Drive app-data folder and restoring it on another
# computer signed in with the same Google account.
#
# These are NOT VITE_* vars, so they stay server-side and are never bundled into
# the browser. For a Desktop-app OAuth client Google treats the secret as
# non-confidential (PKCE protects the flow). Leave unset to disable the feature.
#
# Setup: enable the Google Drive API + add the drive.appdata scope in that
# project's consent screen, create a "Desktop app" OAuth client, then paste here.
# GOOGLE_DRIVE_CLIENT_ID=101922660004-ca8lm0ockacdi2mtorffuk7vioe1eh95.apps.googleusercontent.com
# GOOGLE_DRIVE_CLIENT_SECRET=your-drive-client-secret
