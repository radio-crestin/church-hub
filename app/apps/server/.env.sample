# WARNING: Although this is a server .env, keep in mind that the server will be used as a client on desktop environment. Make sure to not include any sensitive credentials here. Treat this as a browser .env as well.

# This port is only used in local development (default 3001, so it never clashes
# with the installed app on 3000). In prod, Tauri manages the port automatically
PORT=3001

# Database path for SQLite storage (configs, settings, cache)
# Default: ./data/app.db
DATABASE_PATH=./data/app.db

# Enable debug logging (optional)
# DEBUG=true

# --- Church Hub's backend (docs/backend-endpoint.md) ---
# Google sign-in (YouTube, Drive backup, cloud owner), cloud sync, the
# signaling relay and feature requests all go to one backend, which holds the
# Google client credentials: the app ships with none. Override only to point
# at another deployment (a self-hosted backend, a local one).
# CHURCH_HUB_BACKEND_URL=http://localhost:8787
