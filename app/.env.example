# Church Hub environment variables.
# All VITE_* vars are exposed to the client at build time. VITE_PUBLIC_*
# vars are also read by the server and Tauri shell for cross-runtime
# observability.

# PostHog (errors + events) — defaults are baked into the app, override
# here to send events to a different PostHog project.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_x4iC8SNTkLtxooGYmbz6v3nFjYE2v6wXaNgZVHNaxatK
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Client → server connection (mobile + browser dev).
# VITE_API_HOST=localhost
# VITE_API_PORT=3000
# VITE_SERVER_PORT=3000

# Debug logging namespace (see apps/client/src/utils/logger.ts).
# VITE_DEBUG=app:*

# YouTube OAuth helper for livestream uploads.
# VITE_YOUTUBE_OAUTH_SERVER=https://your-oauth-helper.example.com
